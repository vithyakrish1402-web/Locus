# Copy to .env and fill in your keys. .env is gitignored — never commit real keys.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Client Configuration (fill in your project's credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. The Leaflet fallback map is keyless by default (OpenStreetMap raster tiles,
# darkened in CSS). To use a keyed basemap provider instead, paste that provider's full
# {z}/{x}/{y} tile template here, API key included, and set the attribution they require.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
