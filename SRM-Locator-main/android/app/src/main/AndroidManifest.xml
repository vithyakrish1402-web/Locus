<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- WiFi positioning (WifiScanPlugin.java). Both are install-time permissions with no
         prompt. Scanning also needs ACCESS_FINE_LOCATION above: startScan() and
         getScanResults() stay gated on it at every SDK level, and NEARBY_WIFI_DEVICES
         (Android 13+) doesn't cover them, so it is deliberately absent. -->
    <!-- getScanResults() -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- startScan() -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background sharing (sharing/LocationShareService.java). A foreground service of type
         "location", started only while the app is on screen. ACCESS_BACKGROUND_LOCATION is
         deliberately NOT requested: a location foreground service started from a visible app keeps
         its location access after the app is swiped away. POST_NOTIFICATIONS: sharing does not
         start unless its permanent notification can be shown (Android 13+ asks at runtime). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only to post "Tap to resume sharing with <Group>" after a restart (sharing/BootResumeReceiver.java).
         It never starts the location service. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- SOS alerts while LOCUS is closed (sharing/SosNotifications.java): lets the alert for a teammate's
         SOS take over the screen of a locked phone like an incoming call. Android 14+ can take this away
         from an app; the alert is then an ordinary heads-up notification, which still rings. It starts
         nothing by itself: only a notification the service raises, and only for an SOS. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- navigator.vibrate() in the WebView. Without it every call silently did nothing: the
         SOS alarm's vibration (SosOverlay.jsx) never fired on a phone, and neither do the
         press/tab haptic ticks (src/utils/haptics.js). Install-time, no prompt. Takes
         effect from the next APK; a JS bundle can't add a permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- In-app self-updater (see src/hooks/useAppUpdate.js + LocusUpdaterPlugin.java).
         LOCUS is distributed as a sideloaded APK, not via Play, so the app downloads its
         own replacement and hands it to the system installer. Android still shows the
         per-app "install unknown apps" consent the first time; this only allows asking. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Value injected at build time from android/local.properties (MAPS_API_KEY)
             via the manifestPlaceholders entry in app/build.gradle — never hardcoded here. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service
            android:name=".sharing.LocationShareService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".sharing.BootResumeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
